@{
    ViewData["Title"] = "Acceso denegado";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8 col-lg-6">
            <i class="bi bi-shield-lock text-danger display-3"></i>
            <h1 class="fw-bold mt-3">Acceso denegado</h1>
            <p class="lead text-muted">
                No tienes permisos para acceder a esta sección de TechStore.
            </p>

            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <p class="small text-muted">Se intentó acceder a: <code>@returnUrl</code></p>
            }

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Productos">
                    <i class="bi bi-bag-check me-2"></i>Ver catálogo
                </a>
                <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house me-2"></i>Ir al inicio
                </a>
            </div>
        </div>
    </div>
</div>
