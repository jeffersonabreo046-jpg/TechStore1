@model TechStore1.Models.Producto
@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Productos">Catálogo</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Nombre</li>
        </ol>
    </nav>

    <div class="row g-4 align-items-start">
        <div class="col-md-5">
            <img src="@Url.Content("~/images/" + Model.Imagen)" alt="@Model.Nombre"
                 class="img-fluid rounded shadow-sm w-100" style="max-height: 360px; object-fit: cover;" />
        </div>
        <div class="col-md-7">
            <span class="badge bg-primary mb-2">@(Model.Categoria?.Nombre ?? "Sin categoría")</span>
            <h1 class="fw-bold" id="detalle-nombre">@Model.Nombre</h1>
            <p class="lead text-muted">@Model.Descripcion</p>
            <h2 class="h3 text-success fw-bold">$@Model.Precio.ToString("0.00")</h2>
            <p class="mb-1">Stock disponible: <strong>@Model.Stock</strong></p>
            <p>
                Estado:
                <partial name="_EstadoBadge" model="Model.Estado" />
            </p>

            <a asp-controller="Home" asp-action="Productos" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver al catálogo
            </a>
            @if (User.IsInRole(AppRoles.Administrador) || User.IsInRole(AppRoles.Vendedor))
            {
                <a asp-controller="Productos" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning ms-1">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
            }
        </div>
    </div>
</div>
