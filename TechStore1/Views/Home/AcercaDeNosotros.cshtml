@{
    ViewData["Title"] = "Acerca de nosotros";
}


<!-- ENCABEZADO -->
<section class="ts-page-header text-center mb-5">

    <span class="ts-page-label">
        <i class="bi bi-buildings me-2"></i>TechStore
    </span>

    <h1 class="display-5 fw-bold mt-3">
        Acerca de nosotros
    </h1>

    <p class="text-muted mx-auto">
        Conoce quiénes somos, nuestra historia y los principios
        que orientan nuestro trabajo.
    </p>

</section>


<!-- HISTORIA -->
<section class="ts-about-history mb-5">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">

            <span class="ts-page-label">
                Nuestra historia
            </span>

            <h2 class="fw-bold mt-3 mb-3">
                Tecnología pensada para vos
            </h2>

            <p>
                TechStore nace con el objetivo de brindar soluciones
                tecnológicas accesibles, modernas y confiables para
                nuestros clientes.
            </p>

            <p>
                Nos especializamos en la comercialización de computadoras,
                smartphones, monitores, componentes, periféricos y
                accesorios tecnológicos.
            </p>

            <p class="mb-0">
                Además de ofrecer productos seleccionados con criterio
                técnico, brindamos servicios de mantenimiento y reparación
                de laptops y computadoras de escritorio.
            </p>

        </div>


        <div class="col-lg-6">

            <div class="ts-about-visual">

                <div class="ts-about-main-icon">
                    <i class="bi bi-pc-display"></i>
                </div>

                <div class="ts-about-icons">

                    <span>
                        <i class="bi bi-laptop"></i>
                    </span>

                    <span>
                        <i class="bi bi-phone"></i>
                    </span>

                    <span>
                        <i class="bi bi-headset"></i>
                    </span>

                    <span>
                        <i class="bi bi-display"></i>
                    </span>

                </div>

                <h3 class="h5 fw-bold mt-4">
                    Innovación • Calidad • Servicio
                </h3>

                <p class="text-muted mb-0">
                    Soluciones tecnológicas para cada necesidad.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- MISION Y VISION -->

<section class="mb-5">

    <div class="row g-4">

        <!-- MISION -->
        <div class="col-md-6">

            <div class="ts-about-card h-100">

                <div class="ts-about-card-icon">
                    <i class="bi bi-bullseye"></i>
                </div>

                <h2 class="h4 fw-bold">
                    Misión
                </h2>

                <p class="text-muted mb-0">
                    Brindar productos y soluciones tecnológicas de calidad,
                    ofreciendo asesoría y atención personalizada que permita
                    a nuestros clientes elegir la tecnología adecuada para
                    sus necesidades.
                </p>

            </div>

        </div>


        <!-- VISION -->
        <div class="col-md-6">

            <div class="ts-about-card h-100">

                <div class="ts-about-card-icon">
                    <i class="bi bi-eye"></i>
                </div>

                <h2 class="h4 fw-bold">
                    Visión
                </h2>

                <p class="text-muted mb-0">
                    Ser una empresa reconocida en El Salvador por ofrecer
                    soluciones tecnológicas innovadoras, confiables y
                    accesibles, destacándonos por la calidad de nuestros
                    productos y nuestro servicio al cliente.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- VALORES -->
<section>

    <div class="text-center mb-4">

        <span class="ts-page-label">
            Nuestros principios
        </span>

        <h2 class="fw-bold mt-3">
            Valores
        </h2>

        <p class="text-muted">
            Los principios que representan nuestra forma de trabajar.
        </p>

    </div>


    <div class="ts-values-grid">

        <!-- VALOR 1 -->
        <div class="ts-value-card">

            <i class="bi bi-award"></i>

            <h3 class="h5 fw-bold">
                Calidad
            </h3>

            <p>
                Seleccionamos productos y servicios buscando siempre
                ofrecer soluciones confiables.
            </p>

        </div>


        <!-- VALOR 2 -->
        <div class="ts-value-card">

            <i class="bi bi-lightbulb"></i>

            <h3 class="h5 fw-bold">
                Innovación
            </h3>

            <p>
                Nos mantenemos actualizados con las nuevas tendencias
                y soluciones tecnológicas.
            </p>

        </div>


        <!-- VALOR 3 -->
        <div class="ts-value-card">

            <i class="bi bi-people"></i>

            <h3 class="h5 fw-bold">
                Servicio
            </h3>

            <p>
                Escuchamos las necesidades de cada cliente y brindamos
                atención personalizada.
            </p>

        </div>


        <!-- VALOR 4 -->
        <div class="ts-value-card">

            <i class="bi bi-shield-check"></i>

            <h3 class="h5 fw-bold">
                Responsabilidad
            </h3>

            <p>
                Trabajamos con compromiso, transparencia y responsabilidad
                en cada servicio que ofrecemos.
            </p>

        </div>

    </div>

</section>