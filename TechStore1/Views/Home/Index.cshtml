@{
    ViewData["Title"] = "Inicio";
}

<!--BANNER-->
<div class="p-5 mb-5 rounded-4 text-white shadow-lg position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="row align-items-center py-3">
        <div class="col-12 text-center">
          
            <h1 class="display-4 fw-bold text-white mb-3">
                Compra y Arma tu PC con los mejores accesorios del mercado!
            </h1>
            <p class="fs-5 text-light opacity-75 mb-4 col-lg-8 mx-auto">
                Componentes de gama alta, laptops, accesorios y servicio técnico especializado. Todo lo que tu setup necesita para funcionar sin problemas 
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a class="btn btn-primary btn-lg px-4 fw-semibold" asp-controller="Home" asp-action="Productos">
                    <i class="bi bi-bag-check me-2"></i>Ver Productos
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 text-center">
    <div class="col-md-4">
        <div class="p-4 border rounded-4 bg-white shadow-sm h-100">
            <div class="fs-1 text-primary mb-2"><i class="bi bi-truck"></i></div>
            <h5 class="fw-bold text-dark">Envíos a todo el país</h5>
            <p class="text-muted small mb-0">Entregas rapidas y seguras en los 14 departamentos de El Salvador</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 border rounded-4 bg-white shadow-sm h-100">
            <div class="fs-1 text-primary mb-2"><i class="bi bi-shield-check"></i></div>
            <h5 class="fw-bold text-dark">Garantía Local</h5>
            <p class="text-muted small mb-0">Atención directa, repuestos genuinos y soporte tecnico especializado</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 border rounded-4 bg-white shadow-sm h-100">
            <div class="fs-1 text-primary mb-2"><i class="bi bi-tools"></i></div>
            <h5 class="fw-bold text-dark">Ensamblaje y Mantenimiento</h5>
            <p class="text-muted small mb-0">Por la compra de un repuesto o accesorio de PC/Laptop la instalacion del producto es totalmente gratis adicionalmente te brindamos un mantenimiento por la confianza</p>
        </div>
    </div>
</div>