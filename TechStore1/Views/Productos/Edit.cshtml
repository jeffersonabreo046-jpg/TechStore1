@model TechStore1.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container py-4">

    <h1 class="fw-bold mb-4">Editar Producto</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" id="form-producto">
                <input type="hidden" asp-for="Id" />
                <partial name="_ProductoForm" model="Model" />

                <button type="submit" class="btn btn-warning">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-secondary ms-1">Cancelar</a>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
