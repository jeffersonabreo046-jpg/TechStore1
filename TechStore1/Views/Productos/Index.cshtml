@model IEnumerable<TechStore1.Models.Producto>

@{
    ViewData["Title"] = "Administrar Productos";
}

<div class="container py-4">

    <div class="d-flex gap-2 justify-content-end mb-3">
        <a asp-controller="Reportes"
           asp-action="Pdf"
           class="btn btn-danger" id="btn-pdf">
            <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
        </a>

        <a asp-controller="Reportes"
           asp-action="Excel"
           class="btn btn-success" id="btn-excel">
            <i class="bi bi-file-earmark-excel"></i> Exportar Excel
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Administrar Productos</h1>
            <p class="text-muted">Productos registrados en TechStore</p>
        </div>

        @if (User.IsInRole(AppRoles.Administrador) || User.IsInRole(AppRoles.Vendedor))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Agregar producto
            </a>
        }
    </div>

    <partial name="_Alertas" />

    @* View Component *@
    <vc:resumen-inventario></vc:resumen-inventario>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-hover align-middle" id="tabla-productos">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Precio</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td>@producto.Nombre</td>

                                <td>
                                    $@producto.Precio.ToString("0.00")
                                </td>

                                <td>
                                    @producto.Categoria?.Nombre
                                </td>

                                <td>@producto.Stock</td>

                                <td>
                                    <partial name="_EstadoBadge" model="producto.Estado" />
                                </td>

                                <td>
                                    @if (User.IsInRole(AppRoles.Administrador) || User.IsInRole(AppRoles.Vendedor))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@producto.Id"
                                           class="btn btn-warning btn-sm">
                                            Editar
                                        </a>
                                    }

                                    @if (User.IsInRole(AppRoles.Administrador))
                                    {
                                        <a asp-action="Delete"
                                           asp-route-id="@producto.Id"
                                           class="btn btn-danger btn-sm">
                                            Eliminar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>