@model TechStore1.Models.Producto

@{
    ViewData["Title"] = "Agregar Producto";
}

<div class="container py-4">

    <h1 class="fw-bold mb-4">Agregar Producto</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post" id="form-producto">
                <partial name="_ProductoForm" model="Model" />

                <button type="submit" class="btn btn-success">Guardar producto</button>
                <a asp-action="Index" class="btn btn-secondary ms-1">Cancelar</a>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
