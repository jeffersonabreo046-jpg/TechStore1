@model ErrorViewModel
@{
    ViewData["Title"] = Model.Titulo;
    var icono = Model.CodigoEstado == 404 ? "bi-search" : "bi-exclamation-octagon";
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-8 col-lg-6">
            <i class="bi @icono text-danger display-3"></i>
            <p class="text-muted fw-semibold mt-3 mb-1">Error @Model.CodigoEstado</p>
            <h1 class="fw-bold" id="error-titulo">@Model.Titulo</h1>
            <p class="lead text-muted">@Model.Mensaje</p>

            @if (!string.IsNullOrEmpty(Model.Ruta))
            {
                <p class="small text-muted">Ruta: <code>@Model.Ruta</code></p>
            }

            @if (Model.ShowRequestId)
            {
                <p class="small text-muted">
                    Código de seguimiento: <code>@Model.RequestId</code>
                </p>
            }

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house me-2"></i>Ir al inicio
                </a>
                <a class="btn btn-outline-secondary" href="javascript:history.back()">
                    <i class="bi bi-arrow-left me-2"></i>Regresar
                </a>
            </div>
        </div>
    </div>
</div>
